meta {
  name: Update custom pricing
  type: http
  seq: 3
}

put {
  url: {{URL}}/v1/admin/pricing/custom/:id
  body: json
  auth: inherit
}

params:path {
  id: 01a0c452-2a55-7b47-8466-43ccc013182f
}

body:json {
  {
    "input_cost_per_token": 0.0098765
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  The body is a bare `pricing` object, not the full create envelope.
  
  `scope_type`, `model_name` and `scope_virtual_key_id` are fixed at creation and
  **ignored here** — sending them changes nothing. To move an override to another
  scope, delete it and create a new one.
  
  Costs are per single token: 0.0000015 = $1.50 per 1M.
  
  Replaces the whole pricing object, so send every field you want to keep. A field
  you omit stops being overridden and falls back to the base price.
}
