meta {
  name: Create custom pricing
  type: http
  seq: 2
}

post {
  url: {{URL}}/v1/admin/pricing/custom
  body: json
  auth: inherit
}

body:json {
  {
    "name": "acme gpt-4o discount",
    "model_name": "gpt-4o",
    "model_type": "chat",
    "scope_type": "virtualkey",
    "scope_virtual_key_id": "paste-virtual-key-id-here",
    "pricing": {
      "input_cost_per_token": 0.0000020,
      "output_cost_per_token": 0.0000080,
      "cache_read_input_token_cost": 0.0000010
    }
  }
}

settings {
  encodeUrl: true
}

docs {
  **Costs are per single token**, not per million. 0.0000020 = $2.00 per 1M tokens.

  An override replaces fields on a price that already exists — it cannot create
  one. A model with no base price is rejected.

  `scope_type` decides which id is required:
    global      — neither
    provider    — `scope_provider`
    virtualkey  — `scope_virtual_key_id`

  Only the fields you set are overridden; the rest fall through to base. `core.Pricing`
  has ~161 optional fields covering tiers, batches, audio, image, video and OCR.

  One override per (model_name, model_type, scope_type, scope) — a duplicate is
  rejected by a unique index.
}
