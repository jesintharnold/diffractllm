meta {
  name: Create credential
  type: http
  seq: 6
}

post {
  url: {{URL}}/v1/admin/providers/:providername/credentials
  body: json
  auth: inherit
}

params:path {
  providername: azure
}

body:json {
  {
    "provider": "openai",
    "name": "openai-prod-1",
    "api_key": "sk-proj-replace-with-a-real-key",
    "endpoint": "https://api.openai.com",
    "enabled": true,
    "allowed_models": ["*"]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  `endpoint` is required for **every** provider, not just Azure. Omitting it returns
  400 "credentials require an endpoint".
  
  `allowed_models` is required and needs at least one entry. `["*"]` means all.
  
  Credentials on a provider are used round robin — there is no per-credential
  weight. Weight lives on the virtual key, across providers.
  
  For Azure, point `endpoint` at the resource and add `settings.azure`:
  
      "endpoint": "https://my-resource.openai.azure.com",
      "settings": { "azure": { "auth_mode": "api_key", "api_version": "2024-08-01-preview" } }
  
  The response masks `api_key` as `*********`. Until at least one credential
  exists, `/ready` reports `credentials: false`.
}
