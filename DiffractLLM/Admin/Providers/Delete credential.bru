meta {
  name: Delete credential
  type: http
  seq: 8
}

delete {
  url: {{URL}}/v1/admin/providers/:providername/credentials/:id
  body: none
  auth: inherit
}

params:path {
  providername: openai
  id: paste-credential-id-here
}

settings {
  encodeUrl: true
}

docs {
  Deleting the last credential on a provider leaves it unable to serve requests.
}
