meta {
  name: List providers
  type: http
  seq: 1
}

get {
  url: {{URL}}/v1/admin/providers
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
}

docs {
  Every configured provider with whether an adapter is registered for it and how
  many catalog models it has.

  A provider can exist in the table with no adapter in the build — its models are
  priced but cannot be served. Only `openai` and `azure` have adapters today.
}
