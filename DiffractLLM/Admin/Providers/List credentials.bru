meta {
  name: List credentials
  type: http
  seq: 5
}

get {
  url: {{URL}}/v1/admin/providers/:providername/credentials
  body: none
  auth: inherit
}

params:path {
  providername: azure
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  API keys are masked. The store redacts on read, so the plaintext never leaves
  the process after creation.
}
