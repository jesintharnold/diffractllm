meta {
  name: Update provider settings
  type: http
  seq: 4
}

put {
  url: {{URL}}/v1/admin/providers/:providername/settings
  body: json
  auth: inherit
}

params:path {
  providername: azure
}

body:json {
  {
    "network_config": {
      "base_url": "https://api.openai.com",
      "request_timeout": 60000000000,
      "retry_backoff": 500000000,
      "stream_idle_timeout": 60000000000,
      "max_retries": 2,
      "max_conns_per_host": 256,
      "max_response_bytes": 33554432,
      "retry_ambiguous_status": false,
      "allow_private_network": false,
      "insecure_skip_verify": false
    },
    "confirm_unsafe": false
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  **Durations are nanoseconds.** `time.Duration` has no custom JSON unmarshaller,
  so send integers: 60000000000 = 60s, 500000000 = 500ms.
  
  `retry_ambiguous_status` is false by default on purpose. A 408 or 409 may mean
  the upstream already did the work, so retrying can bill the same call twice.
  
  `allow_private_network: true` **and** `insecure_skip_verify: true` both require
  `confirm_unsafe: true` in the same request, or the update is rejected. The dialer
  otherwise refuses loopback, link-local and RFC1918 targets.
  
  Replaces the whole network config — send every field you want to keep.
}
