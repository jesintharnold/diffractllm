meta {
  name: Update credential
  type: http
  seq: 7
}

put {
  url: {{URL}}/v1/admin/providers/:providername/credentials/:id
  body: json
  auth: inherit
}

params:path {
  providername: openai
  id: paste-credential-id-here
}

body:json {
  {
    "provider": "openai",
    "name": "openai-prod-1",
    "endpoint": "https://api.openai.com",
    "enabled": true,
    "allowed_models": ["gpt-4o", "gpt-4o-mini"]
  }
}

settings {
  encodeUrl: true
}

docs {
  `endpoint` is required here too.

  Omit `api_key` to keep the stored secret. Send a new one to replace it.

  Never send the masked `*********` value back — it would overwrite the real key.
}
