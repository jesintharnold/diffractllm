meta {
  name: Update budget
  type: http
  seq: 4
}

put {
  url: {{URL}}/v1/admin/budgets/:id
  body: json
  auth: inherit
}

params:path {
  id: 01a0c31c-6b65-7098-9b41-cdfde4f4ca8a
}

body:json {
  {
    "name": "acme-prod",
    "budget_limit": 750000000000,
    "budget_unit": "USD",
    "budget_duration": "5D",
    "enforce": false
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Writes to the database, then publishes into the in-memory budget cache.
  
  A 500 with "stored, not yet live" means the row was saved but the cache did not
  pick it up — the next `budget_sync` (30s) repairs it.
}
