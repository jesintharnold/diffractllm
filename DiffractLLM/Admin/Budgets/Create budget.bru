meta {
  name: Create budget
  type: http
  seq: 2
}

post {
  url: {{URL}}/v1/admin/budgets
  body: json
  auth: inherit
}

body:json {
  {
    "name": "acme-prod",
    "budget_limit": 500000000000,
    "budget_unit": "USD",
    "budget_duration": "1D",
    "enforce": true
  }
}

settings {
  encodeUrl: true
}

docs {
  `budget_limit` is **nano-USD**: 500000000000 = $500.00. Must be > 0.

  `budget_duration` accepts `1D`, `1W`, `1M`, `1Y`.

  `enforce: true` rejects with 429 once spend passes the limit. `false` only records.

  Copy the returned `id` into the Get / Update / Delete requests in this folder,
  and into `budget_id` when creating a virtual key.
}
