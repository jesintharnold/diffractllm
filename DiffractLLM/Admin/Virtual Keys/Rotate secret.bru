}

post {
  url: {{URL}}/v1/admin/virtual-keys/:id/rotate
  body: none
  auth: inherit
}

params:path {
  id: 01a0c31c-d26e-7a83-a7c6-ba212d9974a5
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Issues a new secret and invalidates the old one immediately.
  
  **The new plaintext is shown once, in this response.** In-flight requests finish
  on the old key; the next one needs the new key.
}
