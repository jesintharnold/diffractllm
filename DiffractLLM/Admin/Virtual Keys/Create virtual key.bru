meta {
  name: Create virtual key
  type: http
  seq: 2
}

post {
  url: {{URL}}/v1/admin/virtual-keys
  body: json
  auth: inherit
}

body:json {
  {
    "client_id": "acme-prod",
    "budget_id": "01a0c31c-6b65-7098-9b41-cdfde4f4ca8a",
    "mode": "weighted",
    "load_balancer": "round_robin",
    "provider_configs": [
      {
        "provider": "openai",
        "allowed_models": ["*"],
        "blocked_models": ["dall-e-3"],
        "weight": 0.7
      },
      {
        "provider": "azure",
        "allowed_models": ["gpt-4o"],
        "weight": 0.3
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  **The plaintext key is returned exactly once, in this response.** It is never
  retrievable again — copy it into the Gateway requests now.
  
  `mode`: `direct` pins one provider, `weighted` draws across them.
  `load_balancer`: `round_robin` (`least_connection` and `latency_based` need the
  metrics engine and are rejected today).
  
  `allowed_models: ["*"]` means allow all. A model in `blocked_models` is refused
  even when allow-all is on — a block always wins.
  
  With two or more providers in `weighted` mode the weights must total 1.0.
  
  Fails if `budget_id` is already bound to another active key: one budget funds
  one live key.
}
