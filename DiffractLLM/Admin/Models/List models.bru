meta {
  name: List models
  type: http
  seq: 1
}

get {
  url: {{URL}}/v1/admin/models?provider=azure
  body: none
  auth: inherit
}

params:query {
  provider: azure
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  The light picker list — model name, type and id only. Built for a dropdown.
  
  Drop the `provider` param to get every provider.
}
