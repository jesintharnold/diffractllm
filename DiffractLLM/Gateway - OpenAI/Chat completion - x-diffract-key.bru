meta {
  name: Chat completion - x-diffract-key
  type: http
  seq: 3
}

post {
  url: {{URL}}/openai/v1/chat/completions
  body: json
  auth: inherit
}

headers {
  x-diffract-key: paste-virtual-key-here
  Content-Type: application/json
}

body:json {
  {
    "model": "openai/gpt-4o",
    "messages": [
      { "role": "user", "content": "Say hello in five words." }
    ],
    "max_tokens": 64
  }
}

settings {
  encodeUrl: true
}

docs {
  Same route, native header instead of `Authorization`. The key is read in this
  order, first match wins:

    x-diffract-key  →  Authorization: Bearer  →  x-api-key  →  x-goog-api-key

  Use `x-diffract-key` when the Authorization header is already carrying something
  else. The other two exist so Anthropic and Gemini SDKs work unchanged.

  This one also pins the provider: `openai/gpt-4o` skips the weighted draw.
}
